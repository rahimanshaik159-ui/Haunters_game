{"rules":{
 "lobby":{".read":"auth!=null","$g":{".write":"auth!=null && (!data.exists() || data.child('host').val()===auth.uid)"}},
 "users":{"$u":{".read":"auth!=null && auth.uid===$u",".write":"auth!=null && auth.uid===$u"}},
 "games":{"$g":{
 ".read":"auth!=null && (!data.exists() || data.child('players').child(auth.uid).exists())",
 "meta":{".read":"auth!=null",".write":"auth!=null && (!data.exists() || data.child('host').val()===auth.uid)"},
 "players":{"$u":{".write":"auth!=null && (auth.uid===$u || root.child('games/'+$g+'/meta/host').val()===auth.uid || (newData.child('alive').val()===false && root.child('games/'+$g+'/players/'+auth.uid).exists()))"}}}}}}
